# Doxyfile
#
# Doxygen configuration for generating browsable reference documentation for
# the Bootstrap shell source and ADR corpus. The Makefile docs target consumes
# the manifest-managed Bash preprocessor filter and generated ADR landing page
# prepared from already-synchronized dependency state.

PROJECT_NAME           = "Bootstrap"
PROJECT_BRIEF          = "Bash-based bootstrap engine reference documentation"

OUTPUT_DIRECTORY       = doc/reference
CREATE_SUBDIRS         = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = .
GENERATE_LATEX         = NO
GENERATE_MAN            = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

INPUT                  = src \
                         lib \
                         doc/adr
RECURSIVE              = YES
FILE_PATTERNS          = *.bash \
                         *.sh \
                         *.md

EXCLUDE                = dist \
                         docs \
                         tests \
                         vendor \
                         doc/reference \
                         doc/adr/templates \
                         doc/adr/preflight-checklist.md \
                         doc/adr/README.intro.md \
                         doc/adr/README.outro.md
EXCLUDE_PATTERNS       = */dist/* \
                         */docs/* \
                         */tests/* \
                         */vendor/* \
                         */doc/reference/* \
                         */doc/adr/templates/* \
                         */README.intro.md \
                         */README.outro.md

EXTENSION_MAPPING      = bash=C \
                         sh=C
FILTER_PATTERNS        = *.bash=vendor/doxygen-bash.awk \
                         *.sh=vendor/doxygen-bash.awk

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES

OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = doc/adr/README.md

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
